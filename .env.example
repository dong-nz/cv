# Site identity (build-time). In CI these are GitHub repository variables on the
# build and resume jobs; locally they live in .env. A production build without
# them fails with an explicit error (src/data/site.ts, vite site-identity plugin).
SITE_URL=
SITE_NAME=

# Edit-mode write path (dev only). Production reads both values from the
# stack's secrets/site_config on the VPS, never from a .env.
# CONTENT_API_BASE is the full Contents-API base URL, repo path + /contents/ included:
#   https://api.github.com/repos/<owner>/<repo>/contents/
CONTENT_API_TOKEN=
CONTENT_API_BASE=
